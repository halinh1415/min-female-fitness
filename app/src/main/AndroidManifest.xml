<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />

        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
    <queries>
        <intent>
            <action android:name="com.google.android.youtube.api.service.START" />
        </intent>
    </queries>

    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <application
        android:name=".FitnessApplication"
        android:exported="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/AppTheme"
        tools:targetApi="36">
        <!--
        WorkManager's default App Startup initializer runs before Application.onCreate().
        This app only needs WorkManager after launch, so initialize it on demand instead
        of adding database/scheduler work to the cold-start critical path.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!--
        Android 16 (targetSdk 36): screenOrientation/resizeableActivity are ignored on
        large screens (sw >= 600dp). Temporary opt-out while layouts are made adaptive.
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <activity
            android:name=".activity.ui.premium.TestActivity"
            android:exported="false" />
        <activity
            android:name=".activity.ui.explore.FilterProgramActivity"
            android:exported="false"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:theme="@style/AppTheme.NoActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.explore.SearchActivity"
            android:exported="false"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:theme="@style/AppTheme.NoActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.guide.GuidePersonalPlanActivity"
            android:exported="false" />
        <activity
            android:name=".activity.ui.settings.CoachOptionActivity"
            android:exported="false"
            android:parentActivityName=".activity.ui.main.YogaActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.workout.CategoryDetailActivity"
            android:exported="false"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:theme="@style/AppTheme.NoActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
            <!-- Intention to show Permissions screen for Health Connect API -->

        </activity>
        <activity
            android:name=".activity.ui.sounds.SoundsActivity"
            android:exported="false"
            android:label="@string/txt_music"
            android:parentActivityName=".activity.ui.main.YogaActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.locknotify.LockScreenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:theme="@style/FullscreenReminderTheme" />

        <activity
            android:name=".activity.ui.onboarding.onboard.OnboardFlowActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Onboarding"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activity.ui.premium.PremiumActivity"
            android:exported="false"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Onboarding">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.premium.PaywallActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Onboarding" />
        <activity
            android:name=".activity.ui.premium.LuckyDrawActivity"
            android:exported="false"
            android:theme="@style/AppTheme.Translucent" />
        <activity
            android:name=".activity.ui.count.CountManagerActivity"
            android:exported="false"
            android:label="@string/txt_select_audio"
            android:parentActivityName=".activity.ui.preview.PreviewActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.preview.PreviewActivity" />
        </activity>
        <activity
            android:name=".activity.ui.workout.ChallengeActivity"
            android:exported="false"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.firstsetup.FirstSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.FullScreen" />
        <activity
            android:name=".activity.ui.boarding.BoardingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.FullScreen" />
        <activity
            android:name=".activity.ui.language.LanguageActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.FullScreen" />
        <activity
            android:name=".activity.ui.weekgoal.SetGoalActivity"
            android:exported="false"
            android:label="@string/txt_set_your_goal"
            android:theme="@style/AppTheme.Main"
            android:parentActivityName=".activity.ui.main.YogaActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <activity
            android:name=".activity.ui.reminder.ReminderActivity"
            android:label="@string/txt_reminder"
            android:parentActivityName=".activity.ui.main.YogaActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.main.YogaActivity"
            android:configChanges="keyboard|keyboardHidden|orientation"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:label="@string/app_name"
            android:largeHeap="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Main">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!--
 For versions starting Android 14, create an activity alias to show the rationale
        of Health Connect permissions once users click the privacy policy link.
        -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".activity.ui.main.YogaActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />

                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".activity.ui.preview.ReplaceActivity"
            android:exported="false"
            android:label="@string/replace"
            android:parentActivityName=".activity.ui.preview.PreviewActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.preview.PreviewActivity" />
        </activity>
        <activity
            android:name=".activity.ui.history.HistoryActivity"
            android:label="@string/mn_history"
            android:theme="@style/AppTheme.NoActionBar"
            android:parentActivityName=".activity.ui.report.ReportActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="mint.woman.female.workout.activity.ui.report.ReportActivity" />
        </activity>
        <activity
            android:name=".activity.ui.badge.BadgeActivity"
            android:exported="false"
            android:label="@string/badge_screen_title"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.workout.ProgramActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:label="Body Hard"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            tools:ignore="LockedOrientationActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="mint.woman.female.workout.activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.diet.ShoppingListActivity"
            android:label="@string/txt_shopping_list"
            android:parentActivityName=".activity.ui.diet.DietActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="mint.woman.female.workout.activity.ui.diet.DietActivity" />
        </activity>
        <activity
            android:name=".activity.ExploreDetailActivity"
            android:label="@string/tab_discover"
            android:theme="@style/AppTheme.NoActionBar"
            android:parentActivityName=".activity.ui.main.YogaActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/txt_app_id" />

        <activity
            android:name=".activity.ui.workout.DoWorkoutActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:largeHeap="true"
            android:launchMode="singleTask"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.FullScreen.WorkoutBars" />
        <activity
            android:name=".activity.ui.report.ReportActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:label="@string/report_center_title"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="mint.woman.female.workout.activity.ui.main.YogaActivity" />
        </activity>

        <receiver
            android:name=".receiver.AlarmReceiver"
            android:exported="false"
            android:permission="RemindWorkout">
            <intent-filter>
                <action android:name="mint.woman.female.workout" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".activity.ui.plan.PersonalPlanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Main" />
        <!-- Nhắc tập theo lịch (nút Schedule ở Report) và nút "Nhắc sau 1 giờ" trên thông báo. -->
        <receiver
            android:name=".notification.NotificationReceiver"
            android:exported="false" />
        <receiver
            android:name=".notification.NotificationActionReceiver"
            android:exported="false" />

        <activity
            android:name=".activity.PolicyActivity"
            android:label="Policy"
            android:parentActivityName=".activity.ui.main.YogaActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="mint.woman.female.workout.activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.SplashActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.FullScreen"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.ui.diet.DietActivity"
            android:label="@string/txt_meal_plan"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:theme="@style/AppTheme.NoActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.diet.MealDetailActivity"
            android:label="Day 1"
            android:parentActivityName=".activity.ui.diet.DietActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.diet.DietActivity" />
        </activity>
        <activity
            android:name=".activity.ui.workout.ExerciseDetailActivity"
            android:label="Detail"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:theme="@style/AppTheme.NoActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.custom.MyWorkoutActivity"
            android:label="@string/txt_customize"
            android:parentActivityName=".activity.ui.main.YogaActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="mint.woman.female.workout.activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.custom.CustomMyWorkoutActivity"
            android:label="@string/txt_customize"
            android:parentActivityName=".activity.ui.main.YogaActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="mint.woman.female.workout.activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.workout.SelectExerciseActivity"
            android:label="@string/txt_select_exercise"
            android:parentActivityName=".activity.ui.custom.CustomMyWorkoutActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.custom.CustomMyWorkoutActivity" />
        </activity>
        <activity
            android:name=".activity.ui.preview.PreviewActivity"
            android:label="Preview"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="mint.woman.female.workout.activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.workout.FinishedActivity"
            android:label=" "
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activity.ui.main.YogaActivity" />
        </activity>
        <activity
            android:name=".activity.ui.workout.RestTimeActivity"
            android:label="@string/txt_rest_time"
            android:parentActivityName=".activity.ui.main.YogaActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="mint.woman.female.workout.activity.ui.main.YogaActivity" />
        </activity>

        <service
            android:name=".receiver.MyFirebaseService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id"
            tools:replace="android:value" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_id" />

        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <!-- Cap quyen doc tam thoi cho anh huy hieu gui sang app chia se. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>

</manifest>
