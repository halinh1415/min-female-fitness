<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme for the new onboarding / paywall: edge-to-edge, no action bar. -->
    <style name="AppTheme.Onboarding" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ob_accent</item>
        <item name="colorPrimaryDark">@color/ob_accent_dark</item>
        <item name="colorAccent">@color/ob_accent</item>
        <item name="colorSecondary">@color/ob_accent</item>
        <item name="android:windowBackground">@color/ob_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:fontFamily">@font/fonts</item>
        <item name="android:windowAnimationStyle">@style/animfade</item>
    </style>

    <style name="OnboardingTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ob_text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="OnboardingSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/ob_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="OnboardingPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ob_on_accent</item>
        <item name="backgroundTint">@color/ob_button_tint</item>
        <item name="cornerRadius">29dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="OnboardingTextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ob_text_secondary</item>
    </style>

    <style name="OnboardingCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/ob_card_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="OnboardingCardLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/ob_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="OnboardingCardValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ob_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="OnboardingUnitButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ob_unit_text</item>
        <item name="backgroundTint">@color/ob_unit_bg</item>
        <item name="strokeColor">@color/ob_accent</item>
    </style>
</resources>
