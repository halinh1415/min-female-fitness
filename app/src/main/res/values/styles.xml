<resources>

    <!-- Legacy View screens with a framework ActionBar. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Chữ của các thành phần Material (toolbar, tab dưới, nút...) dùng bộ font chung. -->
        <item name="textAppearanceHeadline6">@style/TextAppearance.App.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.App.Subtitle1</item>
        <item name="textAppearanceBody1">@style/TextAppearance.App.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.App.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.App.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.App.Button</item>
        <item name="android:windowAnimationStyle">@style/animfade</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Used directly before API 35 and by EdgeToEdgeHelper on API 35+. -->
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="statusBarProtectionColor">@color/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:fontFamily">@font/fonts</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Custom toolbars use colorPrimary; keep their SDK 35+ status area continuous. -->
        <item name="statusBarProtectionColor">@color/colorPrimary</item>
    </style>

    <style name="animfade" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_from_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_to_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_from_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_to_right</item>
    </style>
    <style name="AppTheme.FullScreen" parent="AppTheme.NoActionBar">
        <item name="colorPrimaryDark">@color/Black</item>
        <item name="statusBarProtectionColor">@android:color/transparent</item>
    </style>


    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Dark" />

    <style name="full_screen_dialog" parent="Theme.MaterialComponents.DayNight.DialogWhenLarge">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
        <item name="android:windowSoftInputMode">stateUnspecified|adjustPan</item>
    </style>

    <style name="BottomSheetDialog" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/bottomSheetStyleWrapper</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
    </style>

    <style name="bottomSheetStyleWrapper" parent="Widget.Design.BottomSheet.Modal">
        <item name="behavior_peekHeight">500dp</item>
        <item name="android:state_expanded">false</item>
        <item name="expanded">false</item>
        <item name="android:background">@drawable/rounded_dialog</item>
    </style>

    <!-- Dialog số đo mới tự vẽ nền Compose và tự xử lý navigation bar / bàn phím. -->
    <style name="WeightSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/WeightSheetStyle</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="WeightSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/bottom_up</item>
        <item name="android:windowExitAnimation">@anim/bottom_down</item>
    </style>




    <style name="AdsAppTheme" parent="Theme.MaterialComponents.Light"/>
    <style name="AppTheme.Ads" parent="@style/AdsAppTheme">
        <item name="android:textSize">11.0sp</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:background">@drawable/ads_icon</item>
        <item name="android:paddingLeft">3.0dip</item>
        <item name="android:paddingRight">6.0dip</item>
        <item name="android:paddingBottom">1.0dip</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">15.0px</item>
        <item name="android:minHeight">15.0px</item>
        <item name="android:text">Ad</item>
    </style>
    <style name="NumberPickerText">
        <item name="android:textSize">@dimen/_20sdp</item>
        <item name="android:textColorPrimary">@color/colorAccent</item>

    </style>
    <style name="style_text_area_choose" parent="">
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ffffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/btn_bg_round_corner_ff6699_100</item>
        <item name="android:paddingLeft">@dimen/_8sdp</item>
        <item name="android:paddingTop">@dimen/_4sdp</item>
        <item name="android:paddingRight">@dimen/_8sdp</item>
        <item name="android:paddingBottom">@dimen/_4sdp</item>
        <item name="android:drawableLeft">@drawable/ic_area_choose</item>
        <item name="android:drawablePadding">@dimen/_4sdp</item>
    </style>

    <style name="style_text_area_unchoose" parent="">
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:textColor">#ffff6699</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/btn_bg_round_corner_stroke_ff6699_100</item>
        <item name="android:paddingLeft">@dimen/_8sdp</item>
        <item name="android:paddingTop">@dimen/_4sdp</item>
        <item name="android:paddingRight">@dimen/_8sdp</item>
        <item name="android:paddingBottom">@dimen/_4sdp</item>
        <item name="android:drawableLeft">@drawable/ic_area_unchoose</item>
        <item name="android:drawablePadding">@dimen/_4sdp</item>
    </style>
    <style name="FullscreenReminderTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>
    <style name="SearchSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <!-- Màn trong suốt để vòng quay may mắn hiện như popup đè lên paywall. -->
    <style name="AppTheme.Translucent" parent="AppTheme.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <!-- Màn chính (YogaActivity): nền sáng, status bar sáng, toolbar không bóng. -->
    <style name="AppTheme.Main" parent="AppTheme.NoActionBar">
        <item name="android:statusBarColor">@color/min_main_bg</item>
        <item name="android:windowLightStatusBar">@bool/min_light_status_bar</item>
        <item name="statusBarProtectionColor">@color/min_main_bg</item>
    </style>

    <style name="TextAppearance.Min.ToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/g1_black</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/min_main_text</item>
    </style>

    <style name="TextAppearance.App.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/fonts</item>
        <item name="android:fontFamily">@font/fonts</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/fonts</item>
        <item name="android:fontFamily">@font/fonts</item>
    </style>
    <style name="TextAppearance.App.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/fonts</item>
        <item name="android:fontFamily">@font/fonts</item>
    </style>
    <style name="TextAppearance.App.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/fonts</item>
        <item name="android:fontFamily">@font/fonts</item>
    </style>
    <style name="TextAppearance.App.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/fonts</item>
        <item name="android:fontFamily">@font/fonts</item>
    </style>
    <style name="TextAppearance.App.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/fonts</item>
        <item name="android:fontFamily">@font/fonts</item>
    </style>
</resources>
