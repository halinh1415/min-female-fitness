<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/color_black_33">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_16sdp"/>
                    <solid android:color="@color/White"/>
                    <stroke android:width="@dimen/_2sdp" android:color="@color/colorAccent"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_16sdp"/>
                    <solid android:color="@color/White"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
