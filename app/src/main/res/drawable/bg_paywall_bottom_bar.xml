<?xml version="1.0" encoding="utf-8"?>
<!--
  Thanh hanh dong duoi cung, co vach ngan de tach khoi vung the goi dang cuon phia tren.
  Nut mua truoc day nam trong NestedScrollView nen bi cuon theo noi dung, tren man hinh dai
  co the khuat hoan toan; gio duoc ghim co dinh o day.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/colorTransparent"
                android:startColor="@color/White"
                android:type="linear" />
            <corners android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
        </shape>
    </item>
</layer-list>
