<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"  >
            <corners android:radius="@dimen/_10sdp" />
            <solid android:color="#B28E8C8C"/>
            <stroke android:width="0.1dp" android:color="#68272727" />
        </shape>
    </item>
    <item
        android:id="@android:id/progress"
        >
        <clip>
            <shape>
                <corners
                    android:radius="@dimen/_10sdp" />
                <gradient android:startColor="@color/red_FB45" android:endColor="@color/red_FD7B" android:angle="0"/>
            </shape>
        </clip>
    </item>

</layer-list>
