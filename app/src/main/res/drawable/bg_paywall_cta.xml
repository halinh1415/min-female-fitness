<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/jade_disabled" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="0"
                android:endColor="@color/offer_jade_dark"
                android:startColor="@color/offer_jade"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="0"
                android:endColor="@color/app_start_color"
                android:startColor="@color/app_center_color"
                android:type="linear" />
        </shape>
    </item>
</selector>
