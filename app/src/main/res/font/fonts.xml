<?xml version="1.0" encoding="utf-8"?>
<!--
  Bộ font chung của app:
  - Chữ thường / medium / semibold: Inter (dễ đọc, đủ dấu tiếng Việt, có Cyrillic).
  - Chữ đậm (bold trở lên) - tiêu đề, con số, đồng hồ: Barlow Semi Condensed ExtraBold.
  Glyph thiếu (Ả Rập, Thái, Hindi, CJK...) hệ thống tự dùng font fallback.
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        app:font="@font/inter_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        app:font="@font/inter_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        app:font="@font/inter_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        app:font="@font/g1_black"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        app:font="@font/g1_black"
        app:fontStyle="normal"
        app:fontWeight="800" />
    <font
        app:font="@font/g1_black"
        app:fontStyle="normal"
        app:fontWeight="900" />
</font-family>
