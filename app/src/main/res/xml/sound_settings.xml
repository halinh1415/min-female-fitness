<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <PreferenceCategory app:title="@string/txt_voice_guide">

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_baseline_record_voice_over_24"
            app:key="VOICE_ON"
            app:title="@string/txt_voice_guide" />
        <SeekBarPreference
            app:dependency="VOICE_ON"
            app:key="VOICE_VOLUME"
            app:title="@string/txt_voice_volume"
            android:max="100"
            app:defaultValue="90" />
    </PreferenceCategory>
    <PreferenceCategory app:title="General">
        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_access_time_black_24dp"
            app:key="IS_TICK"
            app:title="@string/sound" />
        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_music_note_black_24dp"
            app:key="MUSIC_ON"
            app:summaryOff="@string/txt_off_music"
            app:summaryOn="@string/txt_on_music"
            app:title="@string/txt_music" />
        <SeekBarPreference
            app:dependency="MUSIC_ON"
            app:key="MUSIC_VOLUME"
            app:title="@string/txt_music_volume"
            android:max="100"
            app:defaultValue="90" />
        <ListPreference
            app:dependency="MUSIC_ON"
            app:entries="@array/arr_music_name"
            app:entryValues="@array/arr_music_value"
            app:icon="@drawable/ic_music_note"
            app:key="BACK_GROUND_MUSIC"
            app:summary="Background 1"
            app:title="@string/txt_music_song"
            app:useSimpleSummaryProvider="true"
            />
        <ListPreference
            android:entries="@array/arr_rest_name"
            android:entryValues="@array/arr_rest_value"
            android:icon="@drawable/ic_baseline_timer_24"
            android:key="REST_TIME0"
            app:useSimpleSummaryProvider="true"
            android:title="@string/txt_rest_time" />
    </PreferenceCategory>

</PreferenceScreen>