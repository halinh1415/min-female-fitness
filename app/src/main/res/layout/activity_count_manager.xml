<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ui.custom.MyWorkoutActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/adView"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_3sdp"
                android:background="@drawable/bg_week_item"
                android:orientation="vertical"
                android:padding="@dimen/_5sdp">

                <TextView
                    android:id="@+id/tv_count_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Count Down"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_count_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lines="3"
                    android:maxLines="3"
                    android:text="@string/txt_count_down_info_1"
                    android:textAlignment="textStart" />

                <mint.woman.female.workout.custom.KKViewPager
                    android:id="@+id/vpCount"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_180sdp"
                    android:minHeight="@dimen/_180sdp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:clipToPadding="false"
                    android:paddingLeft="30dp"
                    android:paddingRight="30dp" />

            </LinearLayout>

            <fragment
                android:id="@+id/a1"
                class="mint.woman.female.workout.custom.DialogSoundSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/btn_close"
                android:layout_alignParentTop="true"
                android:tag="SOUND_FRAGMENT" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</RelativeLayout>