<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ui.weekgoal.WeekGoalNewFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_goal_bound"
        android:orientation="vertical">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/aiCoachCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Tiêu đề HLV AI -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_coach"
                    android:textColor="#2E7D32"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <!-- 2. Lời nhắn động viên từ AI (VD: Chào buổi sáng, nghỉ lâu rồi tập nhé) -->
                <TextView
                    android:id="@+id/txtCoachMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Chào buổi sáng! Hãy dành 10 phút đánh thức cơ thể nào."
                    android:textColor="#333333"
                    android:textSize="16sp" />

                <!-- 3. HỘP HIỂN THỊ BÀI TẬP ĐƯỢC GỢI Ý (Nổi bật) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_suggestion_box"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/suggestion_today"
                        android:textAllCaps="true"
                        android:textColor="#E65100"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Tên bài tập AI chọn -->
                    <TextView
                        android:id="@+id/tvProgramName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Thái Cực cho người mới"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Thông tin phụ (Thời gian, Tag...) -->
                    <TextView
                        android:id="@+id/tvProgramInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="⏱ 15 phút  •  🧘‍♂️ Thư giãn"
                        android:textColor="#666666"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 4. Nút Hành động (Nằm dưới cùng) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingVertical="12dp"
                    android:background="@drawable/background_button_bound"
                    android:text="@string/start_now"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null" /> <!-- Đổi mã màu theo theme app của bạn -->

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/wgv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:layout_marginHorizontal="10dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:id="@+id/linearLayout5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_set_goal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableRight="@drawable/ic_baseline_edit_24"
                        android:drawablePadding="10dp"
                        android:text="@string/txt_week_goal"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_goal_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3/5"
                        android:textAlignment="textEnd"
                        android:textColor="@color/colorAccent"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lnWeekGoalView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rc_week_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layoutManager=".custom.SpanningLinearLayoutManager"
                        tools:itemCount="7"
                        tools:listitem="@layout/day_goal_item_layout" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rc_program_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:itemCount="1"
                        tools:listitem="@layout/small_program_goal" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</FrameLayout>