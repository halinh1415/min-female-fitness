<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    tools:context=".activity.ui.firstsetup.content.WorkoutLevelSetupFragment">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_coach" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/txt_how_long_workout"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textSize="@dimen/_15sdp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_30sdp"
        android:textSize="@dimen/_12sdp"
        android:text="@string/txt_user_setup_description"
        android:textAlignment="center" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">
        <RadioGroup
            android:id="@+id/rd_push_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/cb_level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/background_radio_button"
                android:paddingHorizontal="@dimen/_10sdp"
                android:drawablePadding="@dimen/_10sdp"
                android:drawableTint="@color/White"
                android:minHeight="@dimen/_48sdp"
                android:checked="true"
                android:text="@string/txt_workout_time_level_1"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textSize="@dimen/_16sdp" />
            <RadioButton
                android:id="@+id/cb_level2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/background_radio_button"
                android:paddingHorizontal="@dimen/_10sdp"
                android:drawablePadding="@dimen/_10sdp"
                android:drawableTint="@color/White"
                android:minHeight="@dimen/_48sdp"
                android:text="@string/txt_workout_time_level_2"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textSize="@dimen/_16sdp" />
            <RadioButton
                android:id="@+id/cb_level3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/background_radio_button"
                android:paddingHorizontal="@dimen/_10sdp"
                android:drawablePadding="@dimen/_10sdp"
                android:drawableTint="@color/White"
                android:minHeight="@dimen/_48sdp"
                android:text="@string/txt_workout_time_level_3"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textSize="@dimen/_16sdp" />

        </RadioGroup>
    </LinearLayout>

</LinearLayout>