<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/img_badge"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/badge_screen_title"
            android:padding="22dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/img_badge_lock"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@string/badge_locked"
            android:src="@drawable/ic_badge_lock"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_badge_tier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="@color/badge_muted"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="Gold" />

    <TextView
        android:id="@+id/tv_badge_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/badge_ink"
        android:textSize="21sp"
        android:textStyle="bold"
        tools:text="Hundred Days of Foundation" />

    <TextView
        android:id="@+id/tv_badge_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/badge_muted"
        android:textSize="14sp"
        tools:text="Reach a streak of 100 days." />

    <TextView
        android:id="@+id/tv_badge_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/badge_muted"
        android:textSize="13sp"
        android:textStyle="italic"
        tools:text="Bai Ri Zhu Ji — a hundred days to build the base." />

    <ProgressBar
        android:id="@+id/progress_badge"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="18dp"
        android:max="100"
        android:progressBackgroundTint="@color/badge_track"
        tools:progress="62" />

    <TextView
        android:id="@+id/tv_badge_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/badge_ink"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="62 / 100 days" />

    <TextView
        android:id="@+id/tv_badge_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/badge_muted"
        android:textSize="13sp"
        tools:text="38 days to go" />

    <!-- Chi hien khi huy hieu da dat duoc; BadgeDetailDialog bat/tat. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_badge_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/badge_share"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:visibility="gone"
        app:backgroundTint="@color/badge_jade"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_share_black_24dp"
        app:iconGravity="textStart"
        app:iconTint="@android:color/white"
        tools:visibility="visible" />
</LinearLayout>
