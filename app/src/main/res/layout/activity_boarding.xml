<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ui.boarding.BoardingActivity">


    <TextView
        android:id="@+id/tvSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/txt_skip"
        android:layout_alignParentRight="true"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="@color/colorAccent"
        android:visibility="gone"
        android:layout_margin="@dimen/_10sdp"
        android:textSize="@dimen/_18sdp" />
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vpOnboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/lnBottom"/>

    <LinearLayout
        android:id="@+id/lnBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp">

            <com.make.dots.dotsindicator.DotsIndicator
                android:id="@+id/dotsIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dots_background"
                android:layout_weight="1"
                android:padding="6dp"
                app:dot_drawable="@drawable/ic_dot_darkgrey"
                app:dot_drawable_unselected="@drawable/ic_dot_lightgrey"
                app:dot_height="@dimen/_8sdp"
                app:dot_margin="@dimen/_6sdp"
                app:dot_width="@dimen/_8sdp" />
            <TextView
                android:id="@+id/tvNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_2sdp"
                android:text="@string/td_next"
                android:textAlignment="textEnd"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textSize="@dimen/_18sdp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/layoutAdNative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_frame"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include layout="@layout/loading_native_medium" />
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>