<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    tools:context=".activity.ui.workout.DoWorkoutActivity">
    <ImageView
        android:id="@+id/img_workout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />
    <LinearLayout
        android:id="@+id/ln_workout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/content_workout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Thanh trên cùng nổi trên màn con: ImmersiveHelper đệm cho nó lùi khỏi vùng camera, còn màn con
         (content_workout) phủ kín màn hình để nền tràn viền. -->
    <FrameLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <mint.woman.female.workout.custom.ProgressLineView
            android:id="@+id/workout_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:currentColor="@color/colorPrimary"
            app:emptyColor="#F1E4EA"
            app:fillColor="@color/colorAccent"
            app:separatorColor="@color/White" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_back_activity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:visibility="visible"
                app:srcCompat="@drawable/ic_baseline_arrow_back_24" />

            <TextView
                android:id="@+id/txt_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1/10"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textColor="@color/wk_accent" />

            <TextView
                android:id="@+id/txt_workout_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="00:11"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textColor="@color/wk_accent"
                android:textSize="30sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>