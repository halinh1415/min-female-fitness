<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    tools:context=".activity.ui.firstsetup.FirstSetupActivity">


    <TextView
        android:id="@+id/tvSetupStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="Step 1/4"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textSize="@dimen/_16sdp" />

    <com.make.dots.dotsindicator.DotsIndicator
        android:id="@+id/dotsIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSetupStep"
        android:background="@drawable/dots_background"
        android:padding="6dp"
        android:minWidth="@dimen/_100sdp"
        android:layout_centerHorizontal="true"
        app:dot_drawable="@drawable/ic_dot_darkgrey"
        app:dot_drawable_unselected="@drawable/ic_dot_lightgrey"
        app:dot_height="@dimen/_8sdp"
        app:dot_margin="@dimen/_6sdp"
        app:dot_width="@dimen/_8sdp"/>

    <mint.woman.female.workout.custom.CustomViewPager
        android:id="@+id/vpSetup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/lnBottom"
        android:layout_below="@id/dotsIndicator"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="-15dp" />

    <LinearLayout
        android:id="@+id/lnBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical">
        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_button_bound"
            android:text="@string/td_next"
            android:textSize="@dimen/_14sdp"
            android:layout_margin="10dp"
            android:textColor="@color/White" />

        <FrameLayout
            android:id="@+id/layoutAdNative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_frame"
            android:orientation="vertical"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <include layout="@layout/loading_native_medium" />
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>