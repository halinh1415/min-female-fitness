<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="28dp"
    android:layout_marginEnd="28dp"
    app:cardBackgroundColor="@color/badge_dialog_bg"
    app:cardCornerRadius="26dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/badge_unlocked_celebration_title"
            android:textAllCaps="true"
            android:textColor="@color/badge_dialog_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/img_badge"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/badge_screen_title"
            android:padding="24dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_badge_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/badge_dialog_ink"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Seven Stars" />

        <TextView
            android:id="@+id/tv_badge_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/badge_dialog_muted"
            android:textSize="14sp"
            tools:text="Practice 7 days in a row." />

        <TextView
            android:id="@+id/tv_badge_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/badge_dialog_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="+2 more earned"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_badge_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/badge_continue"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/badge_dialog_accent"
            app:cornerRadius="24dp" />

        <!-- Chi hien khi huy hieu da dat duoc; BadgeUnlockedDialog bat/tat. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_badge_share"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/badge_share"
            android:textAllCaps="false"
            android:textColor="@color/badge_dialog_accent"
            android:textSize="16sp"
            android:visibility="gone"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_share_black_24dp"
            app:iconGravity="textStart"
            app:iconTint="@color/badge_dialog_accent"
            app:strokeColor="@color/badge_dialog_border"
            app:strokeWidth="1dp"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_badge_view_all"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/badge_view_all"
            android:textAllCaps="false"
            android:textColor="@color/badge_dialog_muted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
