<!-- res/layout/custom_preference.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"

    android:gravity="center"
    android:padding="16dp">

    <ImageView
        android:id="@+id/im_icon"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        tools:srcCompat="@drawable/common_google_signin_btn_icon_disabled" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_weight="1"
        android:layout_marginLeft="@dimen/_10sdp">

        <LinearLayout
            android:id="@+id/ll_title"
            android:foreground="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/custom_preference_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Preference Title"
                android:textSize="@dimen/_16sdp"
                android:maxWidth="@dimen/_150sdp"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="@dimen/_16sdp"
                app:autoSizeMinTextSize="@dimen/_10sdp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"/>

            <ImageView
                android:id="@+id/img_google"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                app:srcCompat="@drawable/fui_ic_googleg_color_24dp" />

            <ImageView
                android:id="@+id/im_expand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_expand_more" />
        </LinearLayout>
        <TextView
            android:id="@+id/custom_preference_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This is a custom preference summary"
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>

    <ImageView
        android:id="@+id/img_sync"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        app:srcCompat="@drawable/ic_sync" />
</LinearLayout>
