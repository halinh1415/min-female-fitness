<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/pw_sheet_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/tvExitBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pw_badge_bg"
        android:paddingHorizontal="18dp"
        android:paddingVertical="6dp"
        android:textColor="@color/ob_on_accent"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        style="@style/OnboardingTitle"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/pw_exit_title"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvExitSubtitle"
        style="@style/OnboardingSubtitle"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvExitDisclosure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/ob_text_secondary"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClaim"
        style="@style/OnboardingPrimaryButton"
        android:layout_marginTop="20dp"
        android:text="@string/pw_exit_cta" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDecline"
        style="@style/OnboardingTextButton"
        android:layout_marginTop="4dp"
        android:text="@string/pw_exit_decline" />
</LinearLayout>
