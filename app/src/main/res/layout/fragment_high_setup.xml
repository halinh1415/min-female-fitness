<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".activity.ui.firstsetup.content.HighSetupFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_10sdp"
            android:text="@string/txt_height"
            android:textAlignment="viewStart"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textSize="@dimen/_15sdp" />
        <RadioGroup
            android:id="@+id/rgUnit1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_5sdp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rdKg1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tab_color_selector"
                android:button="@android:color/transparent"
                android:checked="true"
                android:paddingHorizontal="@dimen/_5sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:text="CM"
                android:textColor="@drawable/radio_button_text_selector"
                android:textSize="@dimen/_14sdp" />

            <RadioButton
                android:id="@+id/rdLb1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_5sdp"
                android:background="@drawable/tab_color_selector"
                android:button="@android:color/transparent"
                android:checked="false"
                android:paddingHorizontal="@dimen/_5sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:text="FT"
                android:textColor="@drawable/radio_button_text_selector"
                android:textSize="@dimen/_14sdp" />
        </RadioGroup>
    </LinearLayout>

    <mint.woman.female.workout.custom.SuffixTextView
        android:id="@+id/tv_height_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="170"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="@color/colorAccent"
        android:textSize="@dimen/_20sdp" />

    <mint.woman.female.workout.custom.RuleView
        android:id="@+id/rule_height"
        android:layout_width="70dp"
        android:layout_height="match_parent"
        app:gv_currentValue="2"
        app:gv_maxValue="10"
        app:gv_minValue="1"
        app:gv_numberPerCount="10"
        app:zjun_bgColor="@color/Yellow"
        app:zjun_textSize="18sp" />

</LinearLayout>