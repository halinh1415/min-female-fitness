<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/img_badge"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/badge_screen_title"
            android:padding="15dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/img_badge_lock"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@string/badge_locked"
            android:src="@drawable/ic_badge_lock"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_badge_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@color/badge_ink"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Rooted Like a Tree" />

    <TextView
        android:id="@+id/tv_badge_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/badge_muted"
        android:textSize="11sp"
        tools:text="12 / 50 sessions" />

    <ProgressBar
        android:id="@+id/progress_badge"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="52dp"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressBackgroundTint="@color/badge_track"
        tools:progress="40" />
</LinearLayout>
