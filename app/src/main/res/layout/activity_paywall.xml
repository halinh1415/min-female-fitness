<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/White"
    tools:context=".activity.ui.premium.PaywallActivity">


    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_paywall"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar_paywall"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/iv_hero"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_300sdp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/background_1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <View
                    android:id="@+id/v_hero_fade"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_paywall_hero_fade"
                    app:layout_constraintBottom_toBottomOf="@id/iv_hero"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <TextView
                        android:id="@+id/tv_paywall_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:fontFamily="@font/g1_black"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/pw_title"
                        android:textColor="@color/offer_ink"
                        android:textSize="27sp" />

                    <!--
                      Ba dong quyen loi dat ngay duoi tieu de cho khoang tren do trong, dung lai dung
                      cac chuoi da co san (da dich sang 26 ngon ngu) nen khong phat sinh ban dich moi.
                      Khoi duoc canh giua nhung chu can trai de de doc luot.
                    -->
                    <LinearLayout
                        android:id="@+id/ll_paywall_benefits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="24dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_premium_check"
                            android:drawablePadding="10dp"
                            android:gravity="center_vertical"
                            android:text="@string/txt_premium_plan_unlimited"
                            android:textColor="@color/offer_ink"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:drawableStart="@drawable/ic_premium_check"
                            android:drawablePadding="10dp"
                            android:gravity="center_vertical"
                            android:text="@string/txt_premium_exercise_extend"
                            android:textColor="@color/offer_ink"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:drawableStart="@drawable/ic_premium_check"
                            android:drawablePadding="10dp"
                            android:gravity="center_vertical"
                            android:text="@string/txt_remove_ads"
                            android:textColor="@color/offer_ink"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <include
                android:id="@+id/plan_special"
                layout="@layout/item_paywall_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="20dp" />

            <include
                android:id="@+id/plan_trial"
                layout="@layout/item_paywall_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp" />

            <include
                android:id="@+id/plan_monthly"
                layout="@layout/item_paywall_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp" />

            <LinearLayout
                android:id="@+id/timeline_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_paywall_plan_unselected"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pw_timeline_title"
                    android:textColor="@color/offer_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_timeline_today"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/offer_ink_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_timeline_reminder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/offer_ink_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_timeline_charge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/offer_ink_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_legal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingBottom="@dimen/_30sdp"
                android:lineSpacingExtra="1dp"
                android:text="@string/iap_detail"
                android:textColor="@color/offer_ink_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--
      Thanh hanh dong ghim co dinh duoi day man hinh, tach khoi vung the goi dang cuon o tren
      (giong PremiumNewActivity/item_go_pro_1) de nut mua luon trong tam tay, khong bi cuon mat
      tren man hinh dai hoac danh sach goi dai.
    -->
    <LinearLayout
        android:id="@+id/bottom_bar_paywall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_paywall_bottom_bar"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_store_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="@string/pw_loading"
            android:textColor="@color/offer_ink_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_paywall_cta"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tv_cta_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:textAllCaps="true"
                android:textColor="@color/White"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="7-Day Free Trial" />

            <TextView
                android:id="@+id/tv_cta_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_done"
                android:drawableTint="@color/White"
                android:gravity="center_vertical"
                android:textColor="@color/White"
                android:textSize="14sp"
                tools:text="No payment now" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_billing_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/offer_ink_muted"
            android:textSize="13sp"
            tools:text="Free 7 days trial, then 1.550.000 đ/year\nCancel anytime via Google Play" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_manage"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/pw_manage"
                android:textColor="@color/offer_ink_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_privacy"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/pw_privacy"
                android:textColor="@color/offer_ink_muted"
                android:textSize="12sp" />
        </LinearLayout>



    </LinearLayout>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_paywall_close"
        android:contentDescription="@string/txt_close"
        android:padding="9dp"
        android:src="@drawable/ic_flash_sale_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_restore"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_paywall_restore"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center"
        android:text="@string/pw_restore"
        android:textColor="@color/White"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/iv_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_close" />
</androidx.constraintlayout.widget.ConstraintLayout>
