<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog sửa số reps / thời gian ở màn Preview (DialogEditExercise). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edit_reps_card"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_exercise_name"
                style="@style/DemoHeading"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/fonts"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="18sp"
                tools:text="Push Up" />

            <ImageView
                android:id="@+id/img_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="-8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@android:string/cancel"
                android:padding="8dp"
                android:src="@drawable/ic_edit_reps_close" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fl_exercise"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_edit_reps_media">

            <ImageView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_exercise_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/dm_text"
            android:textSize="14sp"
            tools:text="Start in a plank position with your hands slightly wider than shoulders." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/im_minus"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_edit_reps_step"
                android:contentDescription="-"
                android:src="@drawable/ic_edit_reps_minus" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_rep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fonts"
                    android:includeFontPadding="false"
                    android:textColor="@color/dm_title"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="× 12" />

                <TextView
                    android:id="@+id/tv_each_side"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/wp_each_side"
                    android:textColor="@color/dm_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/im_plus"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_edit_reps_step"
                android:contentDescription="+"
                android:src="@drawable/ic_edit_reps_plus" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_reps_outline"
                android:fontFamily="@font/fonts"
                android:gravity="center"
                android:text="@android:string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/dm_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_replace"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_demo_close"
                android:fontFamily="@font/fonts"
                android:gravity="center"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
