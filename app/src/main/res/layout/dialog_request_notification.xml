<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.cardview.widget.CardView
        android:id="@+id/cardReminder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="72dp"
        android:layout_marginBottom="72dp"
        app:cardBackgroundColor="#F7F5F3"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingTop="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <!-- Icon tròn -->
            <FrameLayout
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:background="@drawable/bg_circle_light"
                android:gravity="center">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_notification_bell"
                    android:contentDescription="@string/app_name"
                    android:scaleType="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/notification_dialog_title"
                android:textAlignment="center"
                android:textColor="#5C6B60"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="6dp"
                android:text="@string/notification_dialog_description"
                android:textAlignment="center"
                android:textColor="#5B5B5B"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnableReminder"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="42dp"
                android:text="@string/notification_dialog_enable"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="#5F8F63"
                app:cornerRadius="28dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLater"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="18dp"
                android:text="@string/notification_dialog_later"
                android:textAllCaps="false"
                android:textColor="#4D4D4D"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="28dp"
                app:elevation="0dp"
                app:strokeColor="#00FFFFFF"
                app:strokeWidth="0dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>